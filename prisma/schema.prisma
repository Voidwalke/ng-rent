generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Перечисления ---

enum TenantPlan {
  free
  basic
  pro
  enterprise
}

enum UserRole {
  super_admin
  admin
  manager
  viewer
}

enum PropertyType {
  office
  retail
  warehouse
  coworking
}

enum UnitStatus {
  available
  reserved
  rented
  maintenance
}

enum ApplicationStatus {
  draft
  submitted
  under_review
  approved
  rejected
  contract_sent
  signed
  active
}

enum ContractStatus {
  draft
  sent
  signed
  active
  expired
  terminated
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
}

// --- Модели ---

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  inn       String?  @db.VarChar(12)
  plan      TenantPlan @default(free)
  settings  Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  properties   Property[]
  units        Unit[]
  clients      Client[]
  applications Application[]
  contracts    Contract[]
  invoices     Invoice[]
  documents    Document[]
  notifications Notification[]
  accessCards  AccessCard[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

model User {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @map("tenant_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(manager)
  fullName     String    @map("full_name")
  is2faEnabled Boolean   @default(false) @map("is_2fa_enabled")
  twoFaSecret  String?   @map("two_fa_secret")
  refreshToken String?   @map("refresh_token")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  reviewedApps  Application[]  @relation("ReviewedBy")
  documents     Document[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model Property {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @map("tenant_id")
  name        String
  address     String
  type        PropertyType
  totalArea   Decimal   @db.Decimal(10, 2) @map("total_area")
  description String?   @db.Text
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  units  Unit[]

  @@index([tenantId])
  @@map("properties")
}

model Unit {
  id          Int        @id @default(autoincrement())
  tenantId    Int        @map("tenant_id")
  propertyId  Int        @map("property_id")
  floor       Int
  areaSqm     Decimal    @db.Decimal(10, 2) @map("area_sqm")
  status      UnitStatus @default(available)
  priceMonth  Decimal    @db.Decimal(12, 2) @map("price_month")
  description String?    @db.Text
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  property     Property      @relation(fields: [propertyId], references: [id])
  applications Application[]

  @@index([tenantId, status])
  @@index([propertyId])
  @@map("units")
}

model Client {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  companyName  String   @map("company_name")
  inn          String?  @db.VarChar(12)
  contactName  String   @map("contact_name")
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  applications Application[]
  accessCards  AccessCard[]

  @@index([tenantId])
  @@map("clients")
}

model Application {
  id           Int               @id @default(autoincrement())
  tenantId     Int               @map("tenant_id")
  unitId       Int               @map("unit_id")
  clientId     Int               @map("client_id")
  status       ApplicationStatus @default(draft)
  desiredStart DateTime          @map("desired_start") @db.Date
  desiredEnd   DateTime          @map("desired_end") @db.Date
  comment      String?           @db.Text
  reviewedById Int?              @map("reviewed_by")
  reviewedAt   DateTime?         @map("reviewed_at")
  createdAt    DateTime          @default(now()) @map("created_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  unit       Unit      @relation(fields: [unitId], references: [id])
  client     Client    @relation(fields: [clientId], references: [id])
  reviewedBy User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  contracts  Contract[]

  @@index([tenantId, status])
  @@index([unitId])
  @@map("applications")
}

model Contract {
  id             Int            @id @default(autoincrement())
  tenantId       Int            @map("tenant_id")
  applicationId  Int            @map("application_id")
  contractNumber String         @unique @map("contract_number")
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime       @map("end_date") @db.Date
  monthlyRent    Decimal        @db.Decimal(12, 2) @map("monthly_rent")
  status         ContractStatus @default(draft)
  docUrl         String?        @map("doc_url")
  signedAt       DateTime?      @map("signed_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
  invoices    Invoice[]
  accessCards AccessCard[]

  @@index([tenantId, status])
  @@map("contracts")
}

model Invoice {
  id            Int           @id @default(autoincrement())
  tenantId      Int           @map("tenant_id")
  contractId    Int           @map("contract_id")
  invoiceNumber String        @map("invoice_number")
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime      @map("due_date") @db.Date
  status        InvoiceStatus @default(pending)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id])

  @@index([tenantId, status])
  @@index([contractId])
  @@map("invoices")
}

model Document {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  mimeType   String   @map("mime_type")
  uploadedBy Int      @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [uploadedBy], references: [id])

  @@index([tenantId])
  @@map("documents")
}

model Notification {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  userId    Int      @map("user_id")
  type      String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

model AccessCard {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  clientId      Int       @map("client_id")
  contractId    Int       @map("contract_id")
  cardNumber    String    @map("card_number")
  isActive      Boolean   @default(true) @map("is_active")
  blockedReason String?   @map("blocked_reason")
  activatedAt   DateTime? @map("activated_at")
  blockedAt     DateTime? @map("blocked_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id])

  @@index([tenantId])
  @@map("access_cards")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  userId     Int      @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("audit_log")
}
