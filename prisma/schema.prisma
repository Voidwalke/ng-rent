generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Перечисления ---

enum TenantPlan {
  free
  basic
  pro
  enterprise
}

enum UserRole {
  super_admin
  admin
  manager
  viewer
}

enum PropertyType {
  office
  retail
  warehouse
  coworking
}

enum UnitStatus {
  available
  reserved
  rented
  maintenance
}

enum ApplicationStatus {
  draft
  submitted
  under_review
  approved
  rejected
  contract_sent
  signed
  active
}

enum ContractStatus {
  draft
  sent
  signed
  active
  expired
  terminated
}

enum InvoiceStatus {
  pending
  paid
  overdue
  cancelled
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  paused
}

enum TicketPriority {
  low
  medium
  high
}

enum TicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed
}

// --- Модели ---

model Tenant {
  id            Int        @id @default(autoincrement())
  name          String
  slug          String     @unique
  inn           String?    @db.VarChar(12)
  kpp           String?    @db.VarChar(9)
  legalAddress  String?    @map("legal_address")
  contactEmail  String?    @map("contact_email")
  contactPhone  String?    @map("contact_phone")
  logoUrl       String?    @map("logo_url")
  plan          TenantPlan @default(free)
  settings      Json       @default("{}")
  customDomain  String?    @unique @map("custom_domain")
  branding      Json?
  emailFromName String?    @map("email_from_name")
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  users              User[]
  properties         Property[]
  units              Unit[]
  clients            Client[]
  applications       Application[]
  contracts          Contract[]
  invoices           Invoice[]
  documents          Document[]
  notifications      Notification[]
  accessCards        AccessCard[]
  auditLogs          AuditLog[]
  subscriptions      Subscription[]
  subscriptionInvoices SubscriptionInvoice[]
  onboarding         OnboardingProgress?
  importJobs         ImportJob[]
  supportTickets     SupportTicket[]
  payments           Payment[]

  @@map("tenants")
}

model User {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(manager)
  fullName      String    @map("full_name")
  phone         String?
  is2faEnabled  Boolean   @default(false) @map("is_2fa_enabled")
  twoFaSecret   String?   @map("two_fa_secret")
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  refreshToken  String?   @map("refresh_token")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  reviewedApps   Application[]   @relation("ReviewedBy")
  documents      Document[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  supportTickets SupportTicket[]
  supportMessages SupportMessage[]
  client         Client?         @relation("ClientUser")

  @@index([tenantId])
  @@map("users")
}

model Property {
  id          Int          @id @default(autoincrement())
  tenantId    Int          @map("tenant_id")
  name        String
  address     String
  city        String?
  type        PropertyType
  totalArea   Decimal      @db.Decimal(10, 2) @map("total_area")
  floorsCount Int?         @map("floors_count")
  yearBuilt   Int?         @map("year_built")
  description String?      @db.Text
  isPublished Boolean      @default(false) @map("is_published")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  units  Unit[]

  @@index([tenantId])
  @@map("properties")
}

model Unit {
  id          Int        @id @default(autoincrement())
  tenantId    Int        @map("tenant_id")
  propertyId  Int        @map("property_id")
  unitNumber  String?    @map("unit_number")
  floor       Int
  areaSqm     Decimal    @db.Decimal(10, 2) @map("area_sqm")
  status      UnitStatus @default(available)
  priceMonth  Decimal    @db.Decimal(12, 2) @map("price_month")
  description String?    @db.Text
  amenities   Json?
  deletedAt   DateTime?  @map("deleted_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  property     Property      @relation(fields: [propertyId], references: [id])
  applications Application[]
  contracts    Contract[]

  @@index([tenantId, status])
  @@index([propertyId])
  @@map("units")
}

model Client {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  companyName  String   @map("company_name")
  inn          String?  @db.VarChar(12)
  kpp          String?  @db.VarChar(9)
  legalAddress String?  @map("legal_address")
  contactName  String   @map("contact_name")
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  bankAccount  String?  @map("bank_account")
  bik          String?  @db.VarChar(9)
  userId       Int?     @unique @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  user         User?         @relation("ClientUser", fields: [userId], references: [id])
  applications Application[]
  accessCards  AccessCard[]
  contracts    Contract[]

  @@index([tenantId])
  @@map("clients")
}

model Application {
  id              Int               @id @default(autoincrement())
  tenantId        Int               @map("tenant_id")
  unitId          Int               @map("unit_id")
  clientId        Int               @map("client_id")
  status          ApplicationStatus @default(draft)
  desiredStart    DateTime          @map("desired_start") @db.Date
  desiredEnd      DateTime          @map("desired_end") @db.Date
  desiredPrice    Decimal?          @db.Decimal(12, 2) @map("desired_price")
  comment         String?           @db.Text
  rejectionReason String?           @map("rejection_reason") @db.Text
  reviewedById    Int?              @map("reviewed_by")
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  unit       Unit      @relation(fields: [unitId], references: [id])
  client     Client    @relation(fields: [clientId], references: [id])
  reviewedBy User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  contracts  Contract[]

  @@index([tenantId, status])
  @@index([unitId])
  @@map("applications")
}

model Contract {
  id                Int            @id @default(autoincrement())
  tenantId          Int            @map("tenant_id")
  applicationId     Int            @map("application_id")
  clientId          Int            @map("client_id")
  unitId            Int            @map("unit_id")
  contractNumber    String         @unique @map("contract_number")
  startDate         DateTime       @map("start_date") @db.Date
  endDate           DateTime       @map("end_date") @db.Date
  monthlyRent       Decimal        @db.Decimal(12, 2) @map("monthly_rent")
  depositAmount     Decimal?       @db.Decimal(12, 2) @map("deposit_amount")
  paymentDay        Int            @default(1) @map("payment_day")
  status            ContractStatus @default(draft)
  docUrl            String?        @map("doc_url")
  signedPdfUrl      String?        @map("signed_pdf_url")
  edoProvider       String?        @map("edo_provider")
  edoDocumentId     String?        @map("edo_document_id")
  edoStatus         String?        @map("edo_status")
  edoSentAt         DateTime?      @map("edo_sent_at")
  signedAt          DateTime?      @map("signed_at")
  terminatedAt      DateTime?      @map("terminated_at")
  terminationReason String?        @map("termination_reason") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])
  unit        Unit        @relation(fields: [unitId], references: [id])
  invoices    Invoice[]
  accessCards AccessCard[]

  @@index([tenantId, status])
  @@map("contracts")
}

model Invoice {
  id               Int           @id @default(autoincrement())
  tenantId         Int           @map("tenant_id")
  contractId       Int           @map("contract_id")
  invoiceNumber    String        @unique @map("invoice_number")
  periodStart      DateTime?     @map("period_start") @db.Date
  periodEnd        DateTime?     @map("period_end") @db.Date
  amount           Decimal       @db.Decimal(12, 2)
  vatAmount        Decimal?      @db.Decimal(12, 2) @map("vat_amount")
  totalAmount      Decimal       @db.Decimal(12, 2) @map("total_amount")
  dueDate          DateTime      @map("due_date") @db.Date
  status           InvoiceStatus @default(pending)
  paidAt           DateTime?     @map("paid_at")
  paidAmount       Decimal?      @db.Decimal(12, 2) @map("paid_amount")
  paymentReference String?       @map("payment_reference")
  createdAt        DateTime      @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  contract Contract  @relation(fields: [contractId], references: [id])
  payments Payment[]

  @@index([tenantId, status])
  @@index([contractId])
  @@map("invoices")
}

model Payment {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  invoiceId     Int      @map("invoice_id")
  provider      String   @default("manual")
  externalId    String?  @map("external_id")
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("RUB")
  status        String   @default("pending")
  paymentMethod String?  @map("payment_method")
  receiptUrl    String?  @map("receipt_url")
  webhookData   Json?    @map("webhook_data")
  createdAt     DateTime @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([externalId])
  @@index([invoiceId])
  @@map("payments")
}

model Document {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileSize   Int?     @map("file_size")
  mimeType   String   @map("mime_type")
  category   String   @default("other")
  uploadedBy Int      @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [uploadedBy], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("documents")
}

model Notification {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  userId    Int      @map("user_id")
  type      String
  title     String
  message   String   @db.Text
  metadata  Json?
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, isRead])
  @@map("notifications")
}

model AccessCard {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  clientId      Int       @map("client_id")
  contractId    Int       @map("contract_id")
  cardNumber    String    @map("card_number")
  holderName    String?   @map("holder_name")
  zones         Json?
  isActive      Boolean   @default(true) @map("is_active")
  blockedReason String?   @map("blocked_reason")
  activatedAt   DateTime? @map("activated_at")
  blockedAt     DateTime? @map("blocked_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id])

  @@index([tenantId])
  @@index([contractId])
  @@map("access_cards")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  userId     Int      @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  tenantId           Int                @map("tenant_id")
  plan               TenantPlan
  priceMonthly       Decimal            @db.Decimal(10, 2) @map("price_monthly")
  startedAt          DateTime           @default(now()) @map("started_at")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  status             SubscriptionStatus @default(trialing)
  canceledAt         DateTime?          @map("canceled_at")
  cancelReason       String?            @map("cancel_reason")
  createdAt          DateTime           @default(now()) @map("created_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  invoices SubscriptionInvoice[]

  @@index([tenantId])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
  subscriptionId Int      @map("subscription_id")
  amount         Decimal  @db.Decimal(10, 2)
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  status         String   @default("pending")
  dueDate        DateTime @map("due_date")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@map("subscription_invoices")
}

model OnboardingProgress {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @unique @map("tenant_id")
  stepsCompleted Json     @default("[]") @map("steps_completed")
  isCompleted    Boolean  @default(false) @map("is_completed")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("onboarding_progress")
}

model ImportJob {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  type         String
  fileUrl      String?  @map("file_url")
  status       String   @default("uploaded")
  totalRows    Int      @default(0) @map("total_rows")
  importedRows Int      @default(0) @map("imported_rows")
  errorRows    Int      @default(0) @map("error_rows")
  errors       Json?
  uploadedBy   Int      @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  completedAt  DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("import_jobs")
}

model SupportTicket {
  id         Int          @id @default(autoincrement())
  tenantId   Int          @map("tenant_id")
  userId     Int          @map("user_id")
  subject    String
  category   String       @default("other")
  priority   TicketPriority @default(medium)
  status     TicketStatus @default(open)
  assignedTo Int?         @map("assigned_to")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  resolvedAt DateTime?    @map("resolved_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([tenantId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id          Int      @id @default(autoincrement())
  ticketId    Int      @map("ticket_id")
  senderType  String   @map("sender_type")
  senderId    Int      @map("sender_id")
  message     String   @db.Text
  attachments Json?
  createdAt   DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
  @@map("support_messages")
}

model ConsentLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  type       String
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  version    String   @default("1.0")
  acceptedAt DateTime @default(now()) @map("accepted_at")

  @@index([userId])
  @@map("consent_log")
}

model DataExportJob {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @map("tenant_id")
  userId      Int       @map("user_id")
  type        String
  status      String    @default("pending")
  fileUrl     String?   @map("file_url")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([tenantId])
  @@map("data_export_jobs")
}

model PushSubscription {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  endpoint   String
  keysP256dh String   @map("keys_p256dh")
  keysAuth   String   @map("keys_auth")
  deviceInfo String?  @map("device_info")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}
