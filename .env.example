# Приложение
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=saas_user
DB_PASSWORD=saas_pass
DB_NAME=saas_crm
DATABASE_URL=postgresql://saas_user:saas_pass@localhost:5432/saas_crm

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBIT_URL=amqp://rabbit:rabbit@localhost:5672
RABBIT_USER=rabbit
RABBIT_PASS=rabbit
