# Приложение
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=saas_user
DB_PASSWORD=saas_pass
DB_NAME=saas_crm
DATABASE_URL=postgresql://saas_user:saas_pass@localhost:5432/saas_crm

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBIT_URL=amqp://rabbit:rabbit@localhost:5672
RABBIT_USER=rabbit
RABBIT_PASS=rabbit

# MinIO (файловое хранилище)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=documents

# ЮKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_WEBHOOK_SECRET=your-webhook-secret

# ClamAV (антивирус)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# SMTP (email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ng-rent.ru

# СКУД
SCUD_PROVIDER=mock
SCUD_API_URL=
SCUD_API_KEY=

# ЭДО
EDO_PROVIDER=mock
EDO_API_URL=
EDO_API_KEY=

# 1С интеграция
INTEGRATION_1C_URL=
INTEGRATION_1C_TOKEN=
INTEGRATION_1C_ENABLED=false

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ng-rent.ru

# PgBouncer
PGBOUNCER_URL=postgresql://saas_user:saas_pass@pgbouncer:5432/saas_crm

# ЮKassa (дополнительно)
YOOKASSA_RETURN_URL=http://localhost:5173/payments/callback
